# Telegram: create a bot with @BotFather and paste its token here.
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN

# Your Render service URL, e.g. https://atiq-image-host.onrender.com
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com

# Use a long random value (at least 16 chars). Do not share it.
WEBHOOK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# Random URL path segment; keep private.
WEBHOOK_PATH=CHANGE_THIS_RANDOM_PATH

# AWS S3 bucket and region
S3_BUCKET=your-unique-s3-bucket-name
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=PASTE_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=PASTE_AWS_SECRET_ACCESS_KEY

# Presigned link validity: 604800 seconds = 7 days (maximum for this setup)
URL_EXPIRY_SECONDS=604800
# Telegram cloud Bot API download limit is 20 MB
MAX_FILE_MB=20
LOG_LEVEL=INFO
